# Credentials for the pronunciation generator only.
#
# These are read by `npm run generate-audio`, which runs on a developer machine
# or in a trusted job. They are never imported by the app, never bundled, and
# never needed to play a recording: the learner plays committed files.
#
# Copy to `.env` and fill in. `.env` is git-ignored.

# --- Israeli Hebrew, via Google Cloud Text-to-Speech ---------------------
GOOGLE_TTS_PROJECT_ID=
# Absolute path to the service account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=
# A natural Israeli Hebrew voice. Female WaveNet by default; swap for a
# Chirp or Neural2 voice where the project has access to one, e.g.
# he-IL-Chirp3-HD-Achernar or he-IL-Standard-A.
GOOGLE_HEBREW_VOICE=he-IL-Wavenet-A

# --- Palestinian Arabic, via Gemini TTS ---------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The TTS model. The flash model is the cheap one and sounds fine.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# A prebuilt Gemini voice, not a locale — the accent comes from the style
# direction below. Kore is female and even-toned; Aoede, Leda and Zephyr are
# the other female options worth hearing first.
GEMINI_ARABIC_VOICE=Kore
# The dialect instruction, sent ahead of every word. This is what makes a clip
# Palestinian rather than Jordanian or MSA. Editing it re-records every Arabic
# clip, because it is part of the fingerprint. Leave blank for the default in
# scripts/audio/config.ts.
GEMINI_ARABIC_STYLE=
# Gemini returns raw PCM, so ffmpeg is required to generate Arabic — see the
# README. Set this to `azure` to fall back to the shelved Azure voice below.
ARABIC_TTS_PROVIDER=gemini

# --- Jordanian Arabic, via Azure Speech (SHELVED) -----------------------
# Only read when ARABIC_TTS_PROVIDER=azure. Kept because it is the one real
# ar-* voice here, and so the Gemini accent has something to be judged
# against. Jordanian is the closest dialect Azure offers to Palestinian
# Levantine; ar-LB-LaylaNeural and ar-SY-AmanyNeural are worth testing.
# Never a Modern Standard Arabic voice.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_ARABIC_VOICE=ar-JO-SanaNeural

# --- Output (optional) --------------------------------------------------
# Root the clip paths are written under. `public` puts them in the bundle.
AUDIO_OUTPUT_ROOT=public
AUDIO_SAMPLE_RATE=24000
AUDIO_LOUDNESS_LUFS=-16
AUDIO_BITRATE_KBPS=96
