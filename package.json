{
  "name": "levantine-language-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "generate-audio": "tsx scripts/generateAudio.ts",
    "validate-audio": "tsx scripts/validateAudio.ts",
    "generate-alphabet-audio": "tsx scripts/generateAlphabetAudio.ts",
    "validate-alphabet": "tsx scripts/validateAlphabet.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "framer-motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@google-cloud/text-to-speech": "^5.8.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
