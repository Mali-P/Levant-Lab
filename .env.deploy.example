# Levantry deploy target for scripts/deploy.sh.
# Canonical documentation: docs/DEPLOYMENT.md
#
# ---------------------------------------------------------------------------
# DO NOT COPY THIS TO .env.deploy TODAY.
#
# scripts/deploy.sh deploys a releases/ + current-symlink architecture that
# production DOES NOT USE. The live server is a git checkout at
# /var/www/levantry, built in place and served by levantry.service; nothing
# reads `current`. The absence of .env.deploy is the only thing standing
# between that script and the live directory — DEPLOY_PATH below defaults to
# /var/www/levantry and the script's own path guard accepts it, so a
# configured run would rsync into the live checkout and prune it with rm -rf
# while the site went on serving the old build.
#
# To deploy, see docs/DEPLOYMENT.md. The real sequence is:
#     git push origin main
#     ssh levantry-vm sudo levantry-deploy main
#
# Keep this file as a record of the alternative model until the three
# competing deployment models in this repo are reconciled or deleted.
# ---------------------------------------------------------------------------
#
# It holds no secrets: DEPLOY_KEY is a path to a key that lives outside the
# repository, never the key itself.

# Hostname or IP of the shared VM that serves levantry.app.
DEPLOY_HOST=203.0.113.10

# SSH user on that VM.
DEPLOY_USER=ubuntu

# Levantry's own directory on the VM. The deploy script refuses to run against
# anything that is not /var/www/levantry or /var/www/levantry-*, because a
# broader path could destroy another application on the same machine.
DEPLOY_PATH=/var/www/levantry

DEPLOY_PORT=22

# Path to the private key authorised for DEPLOY_USER. Never commit the key.
# The key that actually works for this VM is ~/.ssh/oracle_pesto_mali — the
# same one the levantry-vm alias uses in ~/.ssh/config. The old default here,
# ~/.ssh/oracle_cl_master, does not exist on this workstation.
DEPLOY_KEY=~/.ssh/oracle_pesto_mali
